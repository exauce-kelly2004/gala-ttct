# Copier ce fichier en `.env` puis adapter les valeurs.
# Ne jamais committer `.env`.

# --- Application ---
# URL publique du site (utilisée pour les liens dans les e-mails et billets)
APP_URL="http://localhost:3000"

# --- Base de données ---
# Local : PostgreSQL du docker-compose (port 5433 pour ne pas entrer en conflit avec une installation locale)
# Production : URL fournie par l'hébergeur PostgreSQL
DATABASE_URL="postgresql://ttct:ttct_dev_password@localhost:5433/ttct_gala?schema=public"

# --- À configurer lors des étapes suivantes ---
# AUTH_SECRET=""          # Étape 10 — authentification
# PAYMENT_PROVIDER=""     # Étape 7 — prestataire à confirmer
# EMAIL_FROM=""           # Étape 9 — e-mail transactionnel
