# Copier ce fichier en `.env` puis adapter les valeurs.
# Ne jamais committer `.env`.

# --- Application ---
# URL publique du site (utilisée pour les liens dans les e-mails et billets)
APP_URL="http://localhost:3000"

# --- Base de données ---
# Local : PostgreSQL du docker-compose (port 5433 pour ne pas entrer en conflit avec une installation locale)
# Neon : copier l'adresse AVEC « -pooler » dans le nom d'hôte (utilisée par l'application)
DATABASE_URL="postgresql://ttct:ttct_dev_password@localhost:5433/ttct_gala?schema=public"
# Neon : adresse DIRECTE, sans « -pooler » (utilisée seulement par les migrations Prisma).
# En local avec docker-compose, laisser vide.
DIRECT_URL=""

# --- Authentification ---
# Secret de 32 caractères minimum. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- E-mails (Resend) ---
# Sans clé, les e-mails (codes de connexion) s'affichent dans le terminal : pratique en développement.
RESEND_API_KEY=""
EMAIL_FROM="TTCT Gala <onboarding@resend.dev>"
# Adresse qui reçoit les réponses des clients (facultatif). L'expéditeur lui-même ne reçoit pas de courrier.
EMAIL_REPLY_TO=""

# --- Paiement ---
# « simulated » : commande payée aussitôt, sans argent (développement seulement, refusé en production).
# À remplacer par le prestataire choisi (FedaPay, KKiaPay, CinetPay…) quand il sera branché.
PAYMENT_PROVIDER="simulated"

# --- Rappels avant le gala ---
# Secret de la tâche programmée (16 caractères minimum). Sans lui, la route des rappels refuse tout appel.
CRON_SECRET=""
