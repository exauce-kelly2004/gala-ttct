{
  "name": "ttct-gala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:demo": "tsx --conditions=react-server scripts/demo.ts create",
    "db:demo:reset": "tsx --conditions=react-server scripts/demo.ts reset",
    "db:demo:pdf": "tsx --conditions=react-server scripts/demo.ts pdf",
    "db:demo:remove": "tsx --conditions=react-server scripts/demo.ts remove",
    "db:test15": "tsx --conditions=react-server scripts/demo.ts create test15",
    "db:test15:reset": "tsx --conditions=react-server scripts/demo.ts reset test15",
    "db:test15:pdf": "tsx --conditions=react-server scripts/demo.ts pdf test15",
    "db:test15:remove": "tsx --conditions=react-server scripts/demo.ts remove test15"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sparticuz/chromium": "^153.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
